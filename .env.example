# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in from
# Supabase Dashboard > Project Settings > API. Never commit .env.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (sb_publishable_...) or legacy anon key ONLY. Never a service_role / sb_secret_ key.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Demo mode is enabled by `npm run dev:demo` (see .env.demo). Leave unset for the real event.
# VITE_DEMO_MODE=1
