# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in from
# Supabase Dashboard > Project Settings > API. Never commit .env.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (sb_publishable_...) or legacy anon key ONLY. Never a service_role / sb_secret_ key.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Demo mode is enabled by `npm run dev:demo` (see .env.demo). Leave unset for the real event.
# VITE_DEMO_MODE=1

# --- Server-only (Vercel > Settings > Environment Variables; NOT VITE_, never in the browser) ---
# Used by api/ai-score.js and api/guardrail-chat.js for the AI judge and the Round 2 chatbot.
# GEMINI_API_KEY=your-free-key-from-aistudio.google.com
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key   (Supabase > Project Settings > API Keys > secret)
# Optional overrides (comma-separated, tried in order when one is busy / out of free quota):
# GEMINI_JUDGE_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# CHATBOT_ENGINE=ai            (default: built-in rule bot; "ai" uses Gemini with the rule bot as backup)
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
